# Auto detect text files and perform LF normalization
* text=auto

# Go files
*.go text eol=lf

# Web files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# PowerShell
*.ps1 text eol=crlf

# Binary files
*.exe binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
